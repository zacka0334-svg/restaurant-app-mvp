@startuml ClassDiagram
!include common.iuml
title Restaurant App MVP - Class Diagram
hide empty members
abstract class User {
  +id: String
  +fullName: String
  +email: String
  -password: String
  +role: Role
  +login(email: String, password: String): Boolean
  +logout(): void
}
enum Role {
  CUSTOMER
  MANAGER
}
class Customer {
  +favourites: String[]
  +placeOrder(cart: Cart, type: OrderType): Order
  +reserveTable(date: String, time: String, partySize: Number): Reservation
  +cancelReservation(id: String): void
}
class Manager {
  +updateOrderStatus(order: Order, status: OrderStatus): void
  +respondToReservation(r: Reservation, accept: Boolean): void
  +addMenuItem(item: MenuItem): void
  +editPrice(item: MenuItem, price: Number): void
  +toggleAvailability(item: MenuItem): void
}
class Category {
  +id: String
  +name: String
}
class MenuItem {
  +id: String
  +name: String
  +description: String
  +price: Number
  +image: String
  +isSpecial: Boolean
  +isAvailable: Boolean
}
class Cart {
  +promoCode: String
  +discountPercent: Number
  +addItem(item: MenuItem): void
  +removeItem(id: String): void
  +increment(id: String): void
  +decrement(id: String): void
  +applyPromo(code: String): Boolean
  +clear(): void
  +getSubtotal(): Number
}
class CartItem {
  +quantity: Number
  +note: String
  +getLineTotal(): Number
}
class Order {
  +id: String
  +type: OrderType
  +status: OrderStatus
  +pickupTime: String
  +subtotal: Number
  +serviceCharge: Number
  +salesTax: Number
  +discount: Number
  +total: Number
  +timestamp: Number
  +advanceStatus(): void
  +cancel(): void
}
class OrderItem {
  +name: String
  +price: Number
  +quantity: Number
  +note: String
}
enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}
enum OrderType {
  DINE_IN
  TAKEAWAY
}
class Reservation {
  +id: String
  +date: String
  +time: String
  +partySize: Number
  +name: String
  +phone: String
  +status: ReservationStatus
  +cancel(): void
}
enum ReservationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}
class Table {
  +id: String
  +number: Number
  +seats: Number
  +location: String
  +isFreeAt(date: String, time: String): Boolean
}
User <|-- Customer
User <|-- Manager
User --> Role
Category "1" -- "0..*" MenuItem : contains >
Customer "1" *-- "1" Cart : owns >
Cart "1" *-- "0..*" CartItem : holds >
CartItem "0..*" --> "1" MenuItem : refers to >
Customer "1" -- "0..*" Order : places >
Order "1" *-- "1..*" OrderItem : contains >
OrderItem "0..*" --> "1" MenuItem : snapshot of >
Order "0..*" --> "0..1" Table : served at >
Order --> OrderStatus
Order --> OrderType
Customer "1" -- "0..*" Reservation : makes >
Reservation "0..*" --> "1" Table : books >
Reservation --> ReservationStatus
Manager "1" -- "0..*" Order : updates >
Manager "1" -- "0..*" MenuItem : manages >
@enduml
