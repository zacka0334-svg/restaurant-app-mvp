@startuml SequenceDiagram
!include common.iuml
title Customer places an order (Add to Cart -> Order Tracking)
autonumber
actor Customer
participant "MenuScreen" as Menu
participant "MenuItemCard\n(React.memo)" as Card
participant "CartContext\n(cartReducer)" as Cart
participant "CartScreen" as CartS
participant "OrderSummaryScreen" as Sum
participant "OrdersContext\n(ordersReducer)" as Orders
database "AsyncStorage" as Store
participant "OrderTrackingScreen" as Track

Customer -> Card : tap "Add"
Card -> Menu : onAdd(item) [useCallback]
Menu -> Cart : dispatch(ADD_ITEM, item)
Cart --> Menu : new state (items, itemCount)
note right of Cart : tab badge updates live
Customer -> CartS : open Cart tab
CartS -> Cart : dispatch(INCREMENT / UPDATE_NOTE)
Customer -> CartS : enter promo "FEAST20"
CartS -> Cart : dispatch(APPLY_PROMO, code)
alt code valid
  Cart --> CartS : discountPercent = 20
else code invalid
  CartS --> Customer : show "not a valid promo code"
end
Customer -> CartS : choose Dine-in + table (or Takeaway + pickup time)
Customer -> CartS : tap "Review order"
CartS -> Sum : navigate(OrderSummary, {type, table, pickupTime})
Sum -> Sum : useMemo(computeTotals(items, discount))
Sum --> Customer : subtotal, 5% service, 15% tax, discount, total
Customer -> Sum : tap "Place order"
Sum -> Orders : placeOrder({items, totals, type, ...})
Orders -> Orders : dispatch(PLACE_ORDER)\nstatus = Pending, timestamp = now
Orders -> Store : useEffect -> setItem('@rapp/orders')
Sum -> Cart : dispatch(CLEAR_CART)
Sum -> Track : navigation.replace(OrderTracking, {orderId})
activate Track
Track -> Track : useEffect: setInterval(1s) elapsed counter
loop every second until Served
  Track -> Orders : updateStatus(id, next) when 10s / 20s / 30s reached
  Orders --> Track : new status (Preparing -> Ready -> Served)
end
Track --> Customer : step progress indicator + elapsed time
Track -> Track : cleanup: clearInterval on unmount
deactivate Track
@enduml
