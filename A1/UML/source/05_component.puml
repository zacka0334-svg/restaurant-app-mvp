@startuml ComponentDiagram
!include common.iuml
title React Native app - Component Diagram
package "App.js" {
  [SafeAreaProvider]
  [HydrationGate]
}
package "context (Providers)" {
  [ThemeProvider] as TP
  [AuthProvider] as AP
  [MenuProvider] as MP
  [OrdersProvider] as OP
  [ReservationsProvider] as RP
  [CartProvider] as CP
}
package "reducers" {
  [cartReducer]
  [ordersReducer]
  [menuReducer]
  [reservationsReducer]
}
package "hooks (custom)" {
  [useForm]
  [useDebounce]
  [useReservation]
  [usePersistentReducer]
  [useAuth / useTheme / useCart\nuseMenu / useOrders / useReservations] as UH
}
package "navigation" {
  [AppNavigator\n(Root stack + bottom tabs\n+ nested stacks)] as NAV
  [navigationRef]
}
package "screens" {
  [LoginScreen]
  [MenuScreen]
  [CartScreen]
  [OrderSummaryScreen]
  [OrderTrackingScreen]
  [MyOrdersScreen]
  [ReservationScreen]
  [ProfileScreen]
  [ManagerDashboardScreen]
}
package "components" {
  [MenuItemCard\n(React.memo)] as MIC
  [ui (Screen, AppButton,\nField, Chip, Card...)] as UI
  [StatusStepper]
  [LoadingScreen]
}
package "data (mock JSON/JS)" {
  [users.js]
  [menu.js]
  [tables.js]
  [promoCodes.js]
}
database "AsyncStorage" as AS

[SafeAreaProvider] --> TP
TP --> AP
AP --> MP
MP --> OP
OP --> RP
RP --> CP
CP --> [HydrationGate]
[HydrationGate] --> NAV
[HydrationGate] ..> [LoadingScreen]
NAV --> [LoginScreen]
NAV --> [MenuScreen]
NAV --> [CartScreen]
NAV --> [OrderSummaryScreen]
NAV --> [OrderTrackingScreen]
NAV --> [MyOrdersScreen]
NAV --> [ReservationScreen]
NAV --> [ProfileScreen]
NAV --> [ManagerDashboardScreen]

CP ..> [cartReducer]
OP ..> [usePersistentReducer]
MP ..> [usePersistentReducer]
RP ..> [usePersistentReducer]
AP ..> [usePersistentReducer]
[usePersistentReducer] ..> [ordersReducer]
[usePersistentReducer] ..> [menuReducer]
[usePersistentReducer] ..> [reservationsReducer]
[usePersistentReducer] ..> AS

[LoginScreen] ..> [useForm]
[LoginScreen] ..> UH
[MenuScreen] ..> [useDebounce]
[MenuScreen] ..> MIC
[MenuScreen] ..> UH
[ReservationScreen] ..> [useReservation]
[useReservation] ..> UH
[ManagerDashboardScreen] ..> [useForm]
[ManagerDashboardScreen] ..> UH
[ProfileScreen] ..> [navigationRef]
[OrderTrackingScreen] ..> [StatusStepper]
[CartScreen] ..> UH
[OrderSummaryScreen] ..> UH
UH ..> TP
AP ..> [users.js]
MP ..> [menu.js]
RP ..> [tables.js]
[cartReducer] ..> [promoCodes.js]
[screens] ..> UI
@enduml
